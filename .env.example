DJANGO_DEBUG=true
DJANGO_SECRET_KEY=replace-this-with-a-random-secret-at-least-32-characters-long
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:4200

# Leave DB_ENGINE=sqlite for a zero-setup local environment.
DB_ENGINE=sqlite
DB_NAME=sameulshajid
