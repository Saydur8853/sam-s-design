DJANGO_DEBUG=true
DJANGO_SECRET_KEY=replace-this-with-a-random-secret-at-least-32-characters-long
DJANGO_ALLOWED_HOSTS=sameulshajid.art,www.sameulshajid.art,localhost,127.0.0.1
DJANGO_CORS_ALLOWED_ORIGINS=https://sameulshajid.art,https://www.sameulshajid.art,http://localhost:4200
DJANGO_CSRF_TRUSTED_ORIGINS=https://sameulshajid.art,https://www.sameulshajid.art,http://localhost:4200
# For production on sameulshajid.art, set FRONTEND_URL=https://sameulshajid.art
FRONTEND_URL=http://localhost:4200
# FRONTEND_URL=https://sameulshajid.art

# PostgreSQL database configuration
DB_ENGINE=postgresql
DB_NAME=sameulshajid
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# Real Email Verification (Gmail SMTP)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-16-digit-google-app-password
DEFAULT_FROM_EMAIL=sameulshajid.art <noreply@sameulshajid.art>

# Real Google Sign-In (OAuth 2.0)
# Authorized redirect URI: http://localhost:4200/api/v1/auth/google/callback/
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# International Payment Gateway — Lemon Squeezy (Visa, Mastercard, Amex, PayPal, Apple Pay, Google Pay)
# Webhook URL: http://localhost:4200/api/v1/payments/webhooks/lemonsqueezy/
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_STORE_ID=
LEMONSQUEEZY_VARIANT_ID=
LEMONSQUEEZY_WEBHOOK_SECRET=

# Optional Alternative: Stripe Checkout
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

